{
  "name": "e-energietec-ami-sts-enterprise",
  "private": true,
  "version": "7.0.0",
  "description": "Full-Stack AMI, Smart Prepayment STS (IEC 62055-41), MDMS & Grid Management Platform",
  "type": "module",
  "scripts": {
    "dev": "tsx dev.ts",
    "start": "tsx dev.ts",
    "dev:backend": "cd backend && npx tsx server.ts",
    "dev:frontend": "cd frontend && npx vite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npx tsc --noEmit && npx vite build",
    "build:backend": "cd backend && npx tsc --noEmit",
    "seed": "cd backend && npx tsx server/db/seed.ts",
    "test": "cd backend && npx tsx server/tests/run-tests.ts",
    "lint": "cd backend && npx tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
